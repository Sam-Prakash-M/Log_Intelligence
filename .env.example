# Copy to .env (git-ignored). Everything here is optional.

# Enables Claude root-cause analysis. Without it incidents are tagged by keyword rules.
ANTHROPIC_API_KEY=

# Model used for analysis.
LLM_MODEL=claude-opus-5-5

# Host ports, if the defaults are taken on your machine.
# APP_PORT=8080
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000

# Set when Maven Central is unreachable from your network during `docker compose build`.
# MAVEN_CENTRAL_MIRROR=https://maven-central.storage-download.googleapis.com/maven2/
